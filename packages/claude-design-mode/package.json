{
  "name": "claude-design-mode",
  "version": "0.6.3",
  "type": "module",
  "description": "Click an element in your running app and your coding agent edits the exact line that rendered it. Dev-time inspector, Vite plugin, and token-aware design sidebar for Claude Code and other agents.",
  "author": {
    "name": "Billy Mangino",
    "url": "https://billymangino.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pokefang/design-mode.git",
    "directory": "packages/claude-design-mode"
  },
  "homepage": "https://github.com/pokefang/design-mode#readme",
  "bugs": "https://github.com/pokefang/design-mode/issues",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "design-mode",
    "vite-plugin",
    "inspector",
    "devtools",
    "react",
    "design-tokens",
    "ai-agent",
    "developer-tools"
  ],
  "bin": {
    "claude-design-mode": "bin/cli.mjs"
  },
  "scripts": {
    "test": "node --test test/cli.test.mjs test/server.test.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    },
    "./overlay": {
      "types": "./src/overlay.d.ts",
      "default": "./src/overlay.js"
    },
    "./overlay.js": {
      "types": "./src/overlay.d.ts",
      "default": "./src/overlay.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "skills",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/core": "^7.26.0"
  }
}
